<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('../partials/header', { includePwaMeta: true }) %>
  <title>نام نمایشی - Heyraan</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="auth-page">
    <h2 class="auth-title">
      <% if (hasDisplayName) { %>
        تغییر نام
      <% } else { %>
        انتخاب نام
      <% } %>
    </h2>
    <p class="auth-subtitle">این نام در کنار نوشته‌هایت نمایش داده می‌شود</p>

    <% if (errors && errors.length > 0) { %>
      <ul class="auth-errors">
        <% errors.forEach(error => { %>
          <li><%= error %></li>
        <% }); %>
      </ul>
    <% } %>

    <form method="POST" action="/profile/display-name" class="auth-form">
      <input
        id="displayNameInput"
        name="displayName"
        type="text"
        class="auth-input"
        value="<%= values && values.displayName ? values.displayName : (currentUser && currentUser.display_name ? currentUser.display_name : '') %>"
        placeholder="نام نمایشی"
        required
        maxlength="40"
        minlength="2"
        dir="rtl"
      />
      <button type="submit" class="btn btn--primary auth-submit">
        ذخیره
      </button>
    </form>

    <% if (hasDisplayName) { %>
      <form action="/auth/logout" method="POST">
        <button type="submit" class="auth-link-btn">
          خروج از حساب
        </button>
      </form>

      <div class="profile-experimental">
        <span class="profile-experimental__header">قابلیت‌های آزمایشی</span>
        <a href="/feed" class="profile-experimental__item">
          <svg class="profile-experimental__item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/>
            <path d="M7.828 13.07A3 3 0 0 1 12 8.764a3 3 0 0 1 5.004 2.224 3 3 0 0 1-.832 2.083l-3.447 3.62a1 1 0 0 1-1.45-.001z"/>
          </svg>
          <span>دل‌نوشته‌ها</span>
          <svg class="profile-experimental__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
        </a>
      </div>
    <% } %>
  </main>

  <%- include('../partials/footer') %>

  <script src="/client.js"></script>
</body>
</html>


