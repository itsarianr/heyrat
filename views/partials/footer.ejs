<footer>
  <p class="footer-text">حیران - نمایش سادهٔ اشعار پارسی</p>
</footer>

<nav class="bottom-nav">
  <a href="/" class="bottom-nav__item <%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'bottom-nav__item--active' : '' %>">
    <svg class="bottom-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
      <polyline points="9 22 9 12 15 12 15 22"></polyline>
    </svg>
    <span class="bottom-nav__label">خانه</span>
  </a>
  <a href="/feed" class="bottom-nav__item <%= typeof currentPath !== 'undefined' && currentPath === '/feed' ? 'bottom-nav__item--active' : '' %>">
    <svg class="bottom-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/>
      <path d="M7.828 13.07A3 3 0 0 1 12 8.764a3 3 0 0 1 5.004 2.224 3 3 0 0 1-.832 2.083l-3.447 3.62a1 1 0 0 1-1.45-.001z"/>
    </svg>
    <span class="bottom-nav__label">دل‌نوشته‌ها</span>
  </a>
  <a href="/favorites" class="bottom-nav__item <%= typeof currentPath !== 'undefined' && currentPath === '/favorites' ? 'bottom-nav__item--active' : '' %>">
    <svg class="bottom-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
    </svg>
    <span class="bottom-nav__label">علاقه‌مندی‌ها</span>
  </a>
  <a href="/profile/display-name" class="bottom-nav__item <%= typeof currentPath !== 'undefined' && currentPath && currentPath.startsWith('/profile') ? 'bottom-nav__item--active' : '' %>">
    <svg class="bottom-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
      <circle cx="12" cy="7" r="4"></circle>
    </svg>
    <span class="bottom-nav__label">
      <% if (currentUser) { %>
        <%= currentUser.display_name || currentUser.email || 'حساب' %>
      <% } else { %>
        حساب
      <% } %>
    </span>
  </a>
</nav>

<script>
  window.AUTH = Object.assign(
    { isAuthenticated: false, hasDisplayName: false },
    window.AUTH || {},
    {
      isAuthenticated: <%= currentUser ? 'true' : 'false' %>,
      hasDisplayName: <%= currentUser && currentUser.display_name ? 'true' : 'false' %>
    }
  );
</script>

