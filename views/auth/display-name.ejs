<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('../partials/header', { includePwaMeta: true }) %>
  <title>نام نمایشی - Heyraan</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="auth-page">
    <h2 class="auth-title">
      <% if (hasDisplayName) { %>
        تغییر نام
      <% } else { %>
        انتخاب نام
      <% } %>
    </h2>
    <p class="auth-subtitle">این نام در کنار نوشته‌هایت نمایش داده می‌شود</p>

    <% if (errors && errors.length > 0) { %>
      <ul class="auth-errors">
        <% errors.forEach(error => { %>
          <li><%= error %></li>
        <% }); %>
      </ul>
    <% } %>

    <form method="POST" action="/profile/display-name" class="auth-form">
      <input
        id="displayNameInput"
        name="displayName"
        type="text"
        class="auth-input"
        value="<%= values && values.displayName ? values.displayName : (currentUser && currentUser.display_name ? currentUser.display_name : '') %>"
        placeholder="نام نمایشی"
        required
        maxlength="40"
        minlength="2"
        dir="rtl"
      />
      <button type="submit" class="btn btn--primary auth-submit">
        ذخیره
      </button>
    </form>

    <% if (hasDisplayName) { %>
      <form action="/auth/logout" method="POST" style="margin-top: 12px;">
        <button type="submit" class="auth-link-btn">
          خروج از حساب
        </button>
      </form>
    <% } %>
  </main>

  <%- include('../partials/footer') %>

  <script src="/client.js"></script>
</body>
</html>


