<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%- include('partials/header', { includePwaMeta: true }) %>
  <title><%= poet.name %> - <%= book.title %> - <%= section.title %> - حیران</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <% const sections = book.sections || []; %>
    <% const currentIndex = sections.findIndex(s => s.id === section.id); %>
    <% const prevSection = currentIndex > 0 ? sections[currentIndex - 1] : null; %>
    <% const nextSection = currentIndex >= 0 && currentIndex < sections.length - 1 ? sections[currentIndex + 1] : null; %>

    <nav class="breadcrumb">
      <a href="/">خانه</a>
      <span>←</span>
      <span><%= poet.name %></span>
      <span>←</span>
      <span><%= book.title %></span>
    </nav>

    <article class="poem">
      <h2><%= section.title %></h2>

      <div class="screenshot-controls">
        <button id="start-post" class="post-launch-btn">
          <span class="post-launch-btn__icon" aria-hidden="true">&#9998;</span>
          <span class="post-launch-btn__label">ایجاد نوشته</span>
        </button>
        <button id="start-selection">ساخت تصویر از شعر</button>
        <button id="finish-selection" style="display:none;">پایان انتخاب</button>
      </div>

      <!-- Mobile FAB and Menu -->
      <button class="poem-fab" id="poem-fab" aria-label="منو" aria-expanded="false">
        <svg class="poem-fab__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
      <!-- Mobile Finish Selection Button -->
      <button class="poem-finish-selection" id="poem-finish-selection-mobile" style="display:none;">پایان انتخاب</button>
      <div class="poem-fab-menu" id="poem-fab-menu" aria-hidden="true">
        <div class="poem-fab-menu__backdrop" data-fab-close></div>
        <div class="poem-fab-menu__panel">
          <button class="poem-fab-menu__item" data-action="screenshot">
            <svg class="poem-fab-menu__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
            <span class="poem-fab-menu__label">ساخت تصویر از ابیات</span>
          </button>
          <button class="poem-fab-menu__item" data-action="post">
            <svg class="poem-fab-menu__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <span class="poem-fab-menu__label">ایجاد نوشته</span>
          </button>
          <button class="poem-fab-menu__item" data-action="focus">
            <svg class="poem-fab-menu__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="9" y1="3" x2="9" y2="21"></line>
              <line x1="15" y1="3" x2="15" y2="21"></line>
            </svg>
            <span class="poem-fab-menu__label">حالت تمرکز</span>
          </button>
        </div>
      </div>

      <p id="selection-hint" class="selection-hint" style="display:none;">
        ابیات مورد نظر را انتخاب و سپس «پایان انتخاب» را بزنید.
      </p>

      <div class="focus-mode" id="focus-mode" style="display:none;">
        <div class="couplets focus-mode__couplets">
          <% section.couplets.forEach((couplet, index) => { %>
            <div
              class="couplet"
              data-couplet-id="<%= poet.id %>-<%= book.id %>-<%= section.id %>-<%= index %>"
              data-couplet-index="<%= index %>"
            >
              <button class="favorite-btn" data-couplet-id="<%= poet.id %>-<%= book.id %>-<%= section.id %>-<%= index %>" aria-label="افزودن به علاقه‌مندی‌ها">
                <svg class="star-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path fill="none" d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
                </svg>
              </button>
              <p class="verse verse-first"><%= couplet[0] %></p>
              <p class="verse verse-second"><%= couplet[1] %></p>
            </div>
          <% }); %>
        </div>
        <nav class="focus-mode-nav" id="focus-mode-nav">
          <button class="focus-mode-nav__close" id="focus-mode-exit" aria-label="خروج از حالت تمرکز">
            <svg class="focus-mode-nav__close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
          <div class="focus-mode-nav__arrows">
            <button class="focus-mode-nav__arrow" id="focus-mode-prev" aria-label="بیت قبلی">
              <svg class="focus-mode-nav__arrow-icon" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="12 8 8 12 16 12 12 8"></polygon>
              </svg>
            </button>
            <div class="focus-mode-nav__arrow-separator"></div>
            <button class="focus-mode-nav__arrow" id="focus-mode-next" aria-label="بیت بعدی">
              <svg class="focus-mode-nav__arrow-icon" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="12 16 16 12 8 12 12 16"></polygon>
              </svg>
            </button>
          </div>
        </nav>
      </div>

      <div class="couplets" id="normal-couplets">
        <% section.couplets.forEach((couplet, index) => { %>
          <div
            class="couplet"
            data-couplet-id="<%= poet.id %>-<%= book.id %>-<%= section.id %>-<%= index %>"
            data-couplet-index="<%= index %>"
          >
            <button class="favorite-btn" data-couplet-id="<%= poet.id %>-<%= book.id %>-<%= section.id %>-<%= index %>" aria-label="افزودن به علاقه‌مندی‌ها">
              <svg class="star-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path fill="none" d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
              </svg>
            </button>
            <p class="verse verse-first"><%= couplet[0] %></p>
            <p class="verse verse-second"><%= couplet[1] %></p>
          </div>
        <% }); %>
      </div>
    </article>

    <nav class="poem-nav">
      <% if (prevSection) { %>
        <a class="poem-nav__link" href="/<%= poet.id %>/<%= book.id %>/<%= prevSection.id %>">
          <span class="poem-nav__primary">بخش قبل</span>
          <span class="poem-nav__secondary"><%= prevSection.title %></span>
        </a>
      <% } %>
      <% if (nextSection) { %>
        <a class="poem-nav__link poem-nav__link--next" href="/<%= poet.id %>/<%= book.id %>/<%= nextSection.id %>">
          <span class="poem-nav__primary">بخش بعد</span>
          <span class="poem-nav__secondary"><%= nextSection.title %></span>
        </a>
      <% } %>
    </nav>
    <section id="post-sheet" class="post-sheet" aria-hidden="true">
      <div class="post-sheet__backdrop" data-sheet-close></div>
      <div class="post-sheet__panel" role="dialog" aria-modal="true" aria-labelledby="post-sheet-title">
        <header class="post-sheet__header">
          <h3 id="post-sheet-title">نوشتن درباره ابیات انتخاب‌شده</h3>
          <button type="button" class="post-sheet__close" data-sheet-close aria-label="بستن">&times;</button>
        </header>

        <div class="post-sheet__body">
          <div class="post-sheet__couplets" id="post-sheet-couplets"></div>
          <p class="post-sheet__error" id="post-sheet-error" hidden></p>

          <label class="post-sheet__label" for="post-textarea">
            متن نوشته
            <span class="post-sheet__char-count" id="post-char-count">۰ / ۲۸۰</span>
          </label>
          <textarea
            id="post-textarea"
            class="post-sheet__textarea"
            maxlength="280"
            rows="5"
            placeholder="اینجا می‌توانید درباره این ابیات بنویسید..."
          ></textarea>
        </div>

        <footer class="post-sheet__footer">
          <button type="button" class="btn btn--ghost" data-sheet-close>انصراف</button>
          <button type="button" class="btn btn--primary" id="post-submit-btn">انتشار نوشته</button>
        </footer>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <div id="toast-stack" class="toast-stack"></div>

  <script id="poem-data" type="application/json"><%- JSON.stringify({
    poetId: poet.id,
    poetName: poet.name,
    bookId: book.id,
    bookTitle: book.title,
    sectionId: section.id,
    sectionTitle: section.title
  }) %></script>
  <script>
    try {
      const poemDataEl = document.getElementById('poem-data');
      window.POEM_DATA = poemDataEl ? JSON.parse(poemDataEl.textContent) : null;
    } catch (err) {
      window.POEM_DATA = null;
    }
  </script>
  <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
  <script src="/client.js"></script>
</body>
</html>

