<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('../partials/header', { includePwaMeta: true }) %>
  <title>ورود - Heyraan</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="auth-page">
    <h2 class="auth-title">ورود به حساب</h2>
    <p class="auth-subtitle">ایمیل خود را وارد کنید تا به حساب کاربری‌تان در حیران وارد شوید.</p>

    <% if (errors && errors.length > 0) { %>
      <ul class="auth-errors">
        <% errors.forEach(error => { %>
          <li><%= error %></li>
        <% }); %>
      </ul>
    <% } %>

    <form class="auth-form" action="/auth/login" method="POST" novalidate>
      <input
        id="loginEmailInput"
        name="email"
        type="email"
        class="auth-input"
        value="<%= values && values.email ? values.email : '' %>"
        required
        autocomplete="email"
        placeholder="arian@gmail.com"
        dir="ltr"
      />
      <button type="submit" class="btn btn--primary auth-submit">
        ادامه
      </button>
    </form>
  </main>

  <%- include('../partials/footer') %>

  <script src="/client.js"></script>
</body>
</html>


